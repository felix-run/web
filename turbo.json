{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // Read by apps/docs/scripts/fetch-api-spec.mjs. Strict env mode drops any
      // variable not named here before the build sees it.
      "env": ["FELIX_OPENAPI_SPEC", "FELIX_ORIGIN"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    // No dependsOn on purpose: a failing dependency must not silently skip a
    // package's tests, the way ^lint hid chat-ui's for months.
    "test": {
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
