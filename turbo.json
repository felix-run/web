{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "package.json",
    "biome.json",
    "tsconfig.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
