{
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/statusline.sh\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/compact-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-commit.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-touched.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/impact-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/failure-hint.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-log.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm check-types)",
      "Bash(pnpm test)",
      "Bash(pnpm --filter @felix/chat-ui test)",
      "Bash(pnpm --filter @felix/tui test)",
      "Bash(pnpm --filter @felix/cowork-client test)",
      "Bash(pnpm --filter @felix/client test)",
      "Bash(pnpm --filter @felix/skill-format test)",
      "Bash(pnpm chat:build)",
      "Bash(pnpm docs:build)",
      "Bash(pnpm --filter @felix/chat-ui build)",
      "Bash(pnpm --filter @felix/docs build)",
      "Bash(pnpm --filter @felix/tui build)",
      "Bash(pnpm --filter @felix/chat-ui lint)",
      "Bash(pnpm --filter @felix/docs lint)",
      "Bash(pnpm --filter @felix/tui lint)",
      "Bash(pnpm --filter @felix/cowork-client lint)",
      "Bash(pnpm --filter @felix/design lint)",
      "Bash(pnpm --filter @felix/client lint)",
      "Bash(pnpm --filter @felix/protocol lint)",
      "Bash(pnpm --filter @felix/skill-format lint)",
      "Bash(pnpm --filter @felix/test-kit lint)",
      "Bash(pnpm --filter @felix/ui lint)",
      "Bash(pnpm --filter @felix/chat-ui check-types)",
      "Bash(pnpm --filter @felix/docs check-types)",
      "Bash(pnpm --filter @felix/tui check-types)",
      "Bash(pnpm --filter @felix/cowork-client check-types)",
      "Bash(pnpm --filter @felix/design check-types)",
      "Bash(pnpm --filter @felix/client check-types)",
      "Bash(pnpm --filter @felix/protocol check-types)",
      "Bash(pnpm --filter @felix/skill-format check-types)",
      "Bash(pnpm --filter @felix/test-kit check-types)",
      "Bash(pnpm --filter @felix/ui check-types)",
      "Bash(./node_modules/.bin/biome *)",
      "Bash(diff *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)"
    ],
    "ask": [
      "Bash(pnpm chat:deploy)",
      "Bash(pnpm docs:deploy)",
      "Bash(pnpm --filter * deploy*)",
      "Bash(pnpm --filter * run deploy*)",
      "Bash(pnpm run deploy*)",
      "Bash(wrangler *)",
      "Bash(pnpm exec wrangler *)",
      "Bash(pnpm --filter * exec wrangler *)",
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(*migrate:staging*)",
      "Bash(*migrate:production*)"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.secrets/**)",
      "Read(./apps/*/.dev.vars)",
      "Read(./apps/*/.dev.vars.local)",
      "Read(./apps/*/.dev.vars.development)",
      "Read(./apps/*/.dev.vars.preview)",
      "Read(./apps/*/.dev.vars.staging)",
      "Read(./apps/*/.dev.vars.production)"
    ]
  }
}
