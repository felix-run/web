node_modules
.wrangler
dist
.dev.vars
.dev.vars.*
!.dev.vars.example
*.log
packages/harness/src/manifests/bundled.ts
packages/harness/src/skills/bundled.ts

# self-issued JWT signing key (mint-jwt.ts)
.secrets/

# Real deployment config (copy from wrangler.example.jsonc; holds account/resource ids)
wrangler.jsonc
# Docs + chat-ui checked-in configs use vars only (no account ids).
!apps/docs/wrangler.jsonc
!apps/chat-ui/wrangler.jsonc

# Astro / Starlight build cache
apps/docs/.astro/

# Claude Code local audit trail (subagent-log hook)
.claude/logs/

# Turborepo local cache
.turbo/
.neon
.DS_Store

# Impeccable. The *documents* travel: the surface briefs, the critiques ROADMAP.md
# cites as evidence, and the DESIGN.md sidecar carrying what that file's frontmatter
# cannot hold. Only the live picker's working directory stays local — it holds a pid,
# a port and a heartbeat for a server on one machine, which is meaningless anywhere
# else and stale the moment the process exits.
.impeccable/questions/

# Written and removed by scripts/check-tailwind-sources.mjs; only survives a killed run.
apps/chat-ui/src/.check-tailwind-sources.tmp.css
