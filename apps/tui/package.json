{
  "name": "@felix/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Felix in the terminal — full-screen chat against a running harness.",
  "bin": {
    "felix": "./dist/felix.js"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/main.tsx",
    "build": "bun build src/main.tsx --target=bun --outfile dist/felix.js --external @opentui/core --external @opentui/react --external react --banner \"#!/usr/bin/env bun\"",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@felix/client": "workspace:*",
    "@felix/protocol": "workspace:*",
    "@opentui/core": "0.5.9",
    "@opentui/react": "0.5.9",
    "react": "catalog:"
  },
  "devDependencies": {
    "@felix/typescript-config": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
