// The make.felix.run deployment, tracked so CI can deploy it (.github/workflows/deploy.yml). It
// holds no account or resource ids. For your own deployment, change `routes` and FELIX_ORIGIN.
//
// `vars` is PUBLIC — it ships in the Worker config and is readable by anyone
// with access to the account. Only FELIX_ORIGIN belongs here. The Worker takes
// no secrets: browsers sign in to the harness and their bearer passes through.
{
  "name": "felix-chat-ui",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every miss reaches the Worker, which serves the SPA itself. With "single-page-application"
    // a navigation miss is answered with index.html before the Worker runs (since 2025-04-01),
    // which turns the sign-in redirect into the SPA; a `run_worker_first` list fixes that but
    // then a stale /assets/ chunk is answered with index.html and cached as it for a year.
    "not_found_handling": "none"
  },
  "vars": {
    // Public origin of the self-hosted Python Felix harness.
    "FELIX_ORIGIN": "https://api.felix.run"
  },
  "routes": [{ "pattern": "make.felix.run", "custom_domain": true }],
  // Workers Logs: every proxied call's status, so a failure through the proxy is on record.
  // Invocation logs carry the URL, query string included (a sign-in callback's `code` among
  // them); wrangler has no switch to redact it, and the code is single-use.
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false
}
