// Copy to wrangler.jsonc (gitignored) and adjust for your deployment.
//
// `vars` is PUBLIC — it ships in the Worker config and is readable by anyone
// with access to the account. Only FELIX_ORIGIN belongs here. The Worker takes
// no secrets: browsers sign in to the harness and their bearer passes through.
{
  "name": "felix-chat-ui",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // Public origin of the self-hosted Python Felix harness.
    "FELIX_ORIGIN": "https://api.felix.run"
  },
  "routes": [{ "pattern": "make.felix.run", "custom_domain": true }]
}
