// Copy to wrangler.jsonc (gitignored) and adjust for your deployment.
//
// `vars` is PUBLIC — it ships in the Worker config and is readable by anyone
// with access to the account. Only FELIX_ORIGIN belongs here. The gate key and
// the upstream bearer token are secrets:
//   pnpm --filter @felix/float exec wrangler secret put CHAT_UI_KEY
//   pnpm --filter @felix/float exec wrangler secret put FELIX_API_KEY   # optional
{
  "name": "felix-float",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // Public origin of the self-hosted Python Felix harness.
    "FELIX_ORIGIN": "https://api.felix.run"
  },
  "routes": [{ "pattern": "float.felix.run", "custom_domain": true }]
}
