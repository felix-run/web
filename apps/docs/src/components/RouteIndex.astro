---
/*
 * Every route the harness serves, one row each, linking to where it is
 * explained. Built at build time from two sources, so it cannot drift from
 * either:
 *
 * - The routes: `public/openapi.json`, the release spec `/reference/` renders
 *   (fetched by `scripts/fetch-api-spec.mjs` before dev and build). Grouped by
 *   the spec's tags, the same grouping Scalar shows.
 * - The explanation: the guides' own source. A route is "documented" where a
 *   guide gives it a heading (`## \`POST /chat\``) or a table row
 *   (`| \`GET\` | \`/plans/{plan_id}\` | …`); the link goes to the heading
 *   that section sits under. Anchors are GitHub-style slugs, which is what
 *   Starlight generates — the same function `apps/chat-ui/tests/docs-links.test.ts`
 *   checks chat-ui's links with.
 *
 * A route no guide covers still gets a row, linking to its operation in the
 * explorer. Path parameters are compared by position, not name, because the
 * guides and the spec do not always spell them alike (`{id}` vs `{thread_id}`).
 */
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Op {
  method: string;
  path: string;
  summary: string;
  /** First sentence of the operation's docstring, when the harness wrote one. */
  description: string;
  tag: string;
}
interface Doc {
  page: string;
  label: string;
  anchor: string;
  section: string;
  /** The guide's own words for the route, from a table's `Purpose` column. */
  purpose: string;
}

const METHODS = ['get', 'post', 'put', 'patch', 'delete'];
const root = process.cwd();
const specPath = join(root, 'public/openapi.json');

// biome-ignore lint/suspicious/noExplicitAny: the spec is untyped JSON
let spec: any = null;
if (existsSync(specPath)) spec = JSON.parse(readFileSync(specPath, 'utf8'));

/**
 * The first sentence, on one line — or the first two when the first is only a label
 * ("Readiness."), which names a route rather than saying what it does.
 */
function firstSentence(text: string): string {
  const flat = text
    .trim()
    .split(/\n\s*\n/)[0]
    .replace(/\s+/g, ' ');
  const ends = [...flat.matchAll(/[.!?](?=\s|$)/g)].map((m) => (m.index ?? 0) + 1);
  if (ends.length === 0) return flat;
  if (ends[0] >= 25) return flat.slice(0, ends[0]);
  // A label: keep the next sentence, or the rest when it ends without a stop.
  return ends[1] ? flat.slice(0, ends[1]) : flat;
}

const ops: Op[] = [];
for (const [path, item] of Object.entries(spec?.paths ?? {})) {
  // biome-ignore lint/suspicious/noExplicitAny: the spec is untyped JSON
  for (const [method, op] of Object.entries(item as Record<string, any>)) {
    if (!METHODS.includes(method)) continue;
    // A trailing-slash twin (`/a2a/` beside `/a2a`) is the same route.
    if (path.length > 1 && path.endsWith('/') && spec.paths[path.slice(0, -1)]) continue;
    ops.push({
      method: method.toUpperCase(),
      path,
      summary: op.summary ?? '',
      description: firstSentence(op.description ?? ''),
      tag: op.tags?.[0] ?? 'Other',
    });
  }
}

/** GitHub-style heading slug — Starlight's, and docs-links.test.ts's. */
function slug(heading: string): string {
  return heading
    .trim()
    .toLowerCase()
    .replace(/[^\p{L}\p{N}\s-]/gu, '')
    .replace(/\s/g, '-');
}

/** `/plans/{plan_id}?limit=` and `/plans/{id}` both become `/plans/{}`. */
function shape(path: string): string {
  return (
    path
      .split('?')[0]
      .replace(/\{[^}]*\}/g, '{}')
      .replace(/\/$/, '') || '/'
  );
}

/** A markdown table row's cells, not splitting inside backticks. */
function cells(row: string): string[] {
  const out: string[] = [];
  let cur = '';
  let tick = false;
  for (const ch of row.trim().replace(/^\||\|$/g, '')) {
    if (ch === '`') tick = !tick;
    if (ch === '|' && !tick) {
      out.push(cur.trim());
      cur = '';
    } else cur += ch;
  }
  out.push(cur.trim());
  return out;
}

/** A guide cell as one plain sentence: links to their text, emphasis and code marks off. */
function plain(text: string): string {
  return firstSentence(
    text
      .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
      .replace(/\*\*|`/g, '')
      .trim(),
  );
}

/**
 * FastAPI titles an operation from its function name, so the spec says "A2A Rpc",
 * "Mcp Info", "Jwks". Used only when neither a guide nor a docstring describes the
 * route; the acronyms at least read as acronyms.
 */
const ACRONYMS: Record<string, string> = {
  Rpc: 'RPC',
  Mcp: 'MCP',
  Jwks: 'JWKS',
  Ui: 'UI',
  Api: 'API',
  Sse: 'SSE',
  Id: 'ID',
  Json: 'JSON',
  Url: 'URL',
};
function fixAcronyms(summary: string): string {
  return summary.replace(/\b[A-Z][a-z]+\b/g, (w) => ACRONYMS[w] ?? w);
}

const GUIDES: Record<string, string> = {
  'rest-api': 'REST API',
  'management-api': 'Management API',
};
const guideDir = join(root, 'src/content/guide');
const documented = new Map<string, Doc>();
for (const file of readdirSync(guideDir)) {
  const page = file.replace(/\.mdx?$/, '');
  if (!(page in GUIDES)) continue;
  let anchor = '';
  let section = '';
  let inFence = false;
  let purposeColumn = -1;
  for (const line of readFileSync(join(guideDir, file), 'utf8').split('\n')) {
    if (line.startsWith('```')) inFence = !inFence;
    if (inFence) continue;
    const heading = line.match(/^#{2,4}\s+(.*)$/);
    if (heading) {
      section = heading[1].replace(/`/g, '');
      anchor = slug(heading[1]);
    }
    // A table header row: remember which column, if any, says what a route is for.
    if (
      /^\|/.test(line) &&
      !/^\|\s*`?(GET|POST|PUT|PATCH|DELETE)/.test(line) &&
      !/^\|\s*-/.test(line)
    ) {
      purposeColumn = cells(line).findIndex((c) => /^purpose$/i.test(c));
    }
    if (!/^\|/.test(line)) purposeColumn = -1;
    const route =
      line.match(/^#{2,4}\s+`(GET|POST|PUT|PATCH|DELETE) ([^`]+)`/) ??
      line.match(/^\|\s*`?(GET|POST|PUT|PATCH|DELETE)`?\s*\|\s*`([^`]+)`/);
    if (!route) continue;
    const key = `${route[1]} ${shape(route[2])}`;
    // First mention wins: a route's own heading comes before later passing mentions.
    const purpose =
      line.startsWith('|') && purposeColumn >= 0 ? (cells(line)[purposeColumn] ?? '') : '';
    if (!documented.has(key)) {
      documented.set(key, { page, label: GUIDES[page], anchor, section, purpose: plain(purpose) });
    }
  }
}

const groups = new Map<string, Op[]>();
for (const op of ops) {
  const list = groups.get(op.tag) ?? [];
  list.push(op);
  groups.set(op.tag, list);
}
// The spec's own order — first appearance of each tag — which is the order the
// explorer shows. Alphabetical put Threads after Audit here and not there.
// biome-ignore lint/correctness/noUnusedVariables: rendered below
const sorted = [...groups.entries()];
// biome-ignore lint/correctness/noUnusedVariables: rendered below
const explorer = (op: Op) => `/reference/#tag/${op.tag.toLowerCase()}/${op.method}${op.path}`;
const docFor = (op: Op) => documented.get(`${op.method} ${shape(op.path)}`);
/** What a row says a route is for: the guide's words, then the docstring, then the spec's title. */
// biome-ignore lint/correctness/noUnusedVariables: rendered below
const describe = (op: Op) => docFor(op)?.purpose || op.description || fixAcronyms(op.summary);
/**
 * A stable anchor per row — `get-chat-stream-thread_id` — so one route can be
 * linked from chat-ui, a search result or a message.
 */
// biome-ignore lint/correctness/noUnusedVariables: rendered below
const rowId = (op: Op) =>
  `${op.method}${op.path}`
    .toLowerCase()
    .replace(/[{}]/g, '')
    .replace(/[^a-z0-9_]+/g, '-')
    .replace(/^-+|-+$/g, '');
/** The path split after each `/`, so it wraps between segments and never inside one. */
// biome-ignore lint/correctness/noUnusedVariables: rendered below
const segments = (path: string) => path.split(/(?<=\/)/);
// biome-ignore lint/correctness/noUnusedVariables: rendered below
const coveredCount = ops.filter((op) => documented.has(`${op.method} ${shape(op.path)}`)).length;
---

{
  ops.length === 0 ? (
    <p>
      The route list is built from <code>public/openapi.json</code>, which is not present in this
      build. Run <code>node scripts/fetch-api-spec.mjs</code> in <code>apps/docs</code>, or browse
      the <a href="/reference/">OpenAPI explorer</a>.
    </p>
  ) : (
    <>
      <p class="route-count">
        {ops.length} routes, {coveredCount} of them explained in a guide.
      </p>
      <div class="route-filter" data-route-filter hidden>
        <label for="route-filter-input">Filter routes</label>
        <input
          id="route-filter-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="/chat/stream, approvals, POST…"
        />
        <p class="route-filter-status" role="status" aria-live="polite"></p>
      </div>
      <nav class="route-tags" aria-label="Route groups">
        <ul>
          {sorted.map(([tag, list]) => (
            <li>
              <a href={`#${slug(tag)}`}>{tag}</a> <span>{list.length}</span>
            </li>
          ))}
        </ul>
      </nav>
      {sorted.map(([tag, list]) => (
        <section class="route-group" data-route-group>
          <h2 id={slug(tag)}>{tag}</h2>
          <ul class="route-list">
            {list.map((op) => {
              const doc = docFor(op);
              const what = describe(op);
              return (
                <li id={rowId(op)} data-route={`${op.method} ${op.path} ${what}`.toLowerCase()}>
                  <code class="route">
                    <span class="verb">{op.method}</span>{' '}
                    {segments(op.path).map((part, i) => (
                      <>
                        {i > 0 && <wbr />}
                        {part}
                      </>
                    ))}
                  </code>
                  <span class="summary">{what}</span>
                  {doc ? (
                    <a class="where" href={`/guide/${doc.page}/#${doc.anchor}`}>
                      {doc.label}
                      <span class="sr-only">, {doc.section}</span>
                    </a>
                  ) : (
                    <a class="where" href={explorer(op)}>
                      Explorer
                      <span class="sr-only">, {op.method} {op.path}</span>
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </>
  )
}

<style>
  .route-count {
    color: var(--sl-color-gray-3);
  }

  /* The page's own contents: Starlight's TOC reads only MDX headings, and these
     are rendered here. */
  .route-tags ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: var(--sl-text-sm);
  }
  .route-tags li {
    margin: 0;
  }
  .route-tags a {
    color: var(--sl-color-white);
    text-underline-offset: 0.2em;
  }
  .route-tags span {
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }

  /* A group heading labels a list; it is not a page section. At the page's h2
     size a one-route group (A2A, Artifacts) outweighed everything around it. */
  .route-group h2 {
    font-size: var(--sl-text-lg);
    margin-top: 1.75rem;
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }

  .route-list li {
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }
  .route-list li:target {
    background-color: color-mix(in srgb, var(--sl-color-white) 6%, var(--sl-color-black));
  }

  .route-filter {
    margin-top: 1rem;
    max-inline-size: 24rem;
  }
  .route-filter label {
    display: block;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 0.25rem;
  }
  .route-filter input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
  }
  .route-filter input::placeholder {
    color: var(--sl-color-gray-3);
  }
  .route-filter-status {
    margin: 0.25rem 0 0;
    min-height: 1.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .route-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }

  /*
   * A row is route · summary · where. Wide, the three sit on one line with the
   * route column sized to the longest path; narrow, the route takes its own
   * line and the other two sit under it. Rows are hairline-separated, like
   * every other list here.
   */
  .route-list li {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr) minmax(0, 9rem);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    margin: 0;
  }

  .route {
    font-size: var(--sl-text-sm);
    background: none;
    padding: 0;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }

  .verb {
    display: inline-block;
    min-width: 3.25rem;
    color: var(--sl-color-gray-3);
  }

  .summary {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .where {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 50rem) {
    .route-list li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .route {
      grid-column: 1 / -1;
    }
    .where {
      text-align: end;
    }
  }
</style>

<script>
  // Progressive: without script the filter stays hidden and the page is the full list.
  const box = document.querySelector<HTMLElement>('[data-route-filter]');
  const input = box?.querySelector<HTMLInputElement>('input');
  const status = box?.querySelector<HTMLElement>('.route-filter-status');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-route]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-route-group]')];
  if (box && input && status) {
    box.hidden = false;
    input.addEventListener('input', () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const row of rows) {
        const hay = row.dataset.route ?? '';
        const match = terms.every((t) => hay.includes(t));
        row.hidden = !match;
        if (match) shown++;
      }
      for (const group of groups) {
        group.hidden = !group.querySelector('[data-route]:not([hidden])');
      }
      status.textContent = terms.length
        ? shown === 0
          ? 'No route matches.'
          : `${shown} of ${rows.length} routes`
        : '';
    });
  }
</script>
