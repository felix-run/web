---
/*
 * The Manifest reference's own index: every `spec.*` field, grouped under the
 * page it is on, with a filter. The reference is seven pages of fields and most
 * visits are a lookup of one, so this is the tier between "which page" and "one
 * field" that a table of contents cannot be across pages.
 *
 * Built at build time from the pages' source, the way RouteIndex reads the
 * guides, so a field added to a page is in the index without being listed
 * twice: each page in `PAGES` is a band named by its title, and each `##`
 * heading on it is a field. A page in the folder that is missing from `PAGES`
 * fails the build rather than dropping out of the index. Anchors are the same
 * GitHub-style slugs Starlight generates (`slug` in `./headings`).
 */
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { HUB_DIR, readPage, slug } from './headings';

/** The pages under `guide/manifest-reference/`, in sidebar order. */
const PAGES = ['model', 'tools', 'tool-families', 'agents', 'memory', 'running', 'governance'];

interface Field {
  /** The heading as written, code marks off: `spec.model`. */
  name: string;
  /** What the filter matches: the name plus the keys its tables list. */
  hay: string;
  href: string;
}

const dir = join(HUB_DIR, 'manifest-reference');
const unlisted = readdirSync(dir)
  .map((f) => f.replace(/\.mdx?$/, ''))
  .filter((p) => !PAGES.includes(p));
if (unlisted.length > 0) {
  throw new Error(`FieldIndex: add ${unlisted.join(', ')} to PAGES, in sidebar order`);
}

const bands: { name: string; href: string; fields: Field[] }[] = [];
for (const page of PAGES) {
  const { title, body } = readPage(join(dir, `${page}.mdx`));
  const base = `/guide/manifest-reference/${page}/`;
  const band = { name: title, href: base, fields: [] as Field[] };
  bands.push(band);
  let inFence = false;
  let current: Field | null = null;
  for (const line of body) {
    if (line.startsWith('```')) inFence = !inFence;
    if (inFence) continue;
    const h2 = line.match(/^## (.*)$/);
    if (h2) {
      const name = h2[1].replace(/\x60/g, '');
      current = { name, hay: name.toLowerCase(), href: `${base}#${slug(h2[1])}` };
      band.fields.push(current);
      continue;
    }
    // The keys a field's tables list join what the filter matches, so "schedule_task"
    // finds `spec.scheduling` and "allow_hosts" finds `spec.network`: an operator often knows the
    // key they set and not the section it lives in. (A backtick is spelled \x60 in
    // these patterns: Astro's compiler reads a literal one inside a regex in the
    // frontmatter as the start of a template string.)
    const key = current && line.match(/^\|\s*\x60([^\x60]+)\x60\s*\|/);
    if (current && key) current.hay += ` ${key[1].toLowerCase()}`;
  }
}
const groups = bands.filter((b) => b.fields.length > 0);
// biome-ignore lint/correctness/noUnusedVariables: rendered below
const total = groups.reduce((n, b) => n + b.fields.length, 0);
/** `spec.model` reads as `model` here: every field in the index is under `spec`. */
// biome-ignore lint/correctness/noUnusedVariables: rendered below
const short = (name: string) => name.replace(/\bspec\./g, '');
---

<nav class="field-index not-content" aria-labelledby="field-index-label">
  <p id="field-index-label" class="field-index-label">
    {total} fields under <code>spec</code>, in {groups.length} groups
  </p>
  <div class="field-filter" data-field-filter hidden>
    <label for="field-filter-input">Filter fields</label>
    <input
      id="field-filter-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="model, approvals, allow_hosts…"
      aria-describedby="field-filter-status"
    />
    <p id="field-filter-status" class="field-filter-status" role="status" aria-live="polite"></p>
  </div>
  {
    groups.map((band) => (
      <div class="field-group" data-field-group>
        <a class="field-band" href={band.href}>
          {band.name}
        </a>
        <ul>
          {band.fields.map((field) => (
            <li data-field={field.hay}>
              <a href={field.href}>{short(field.name)}</a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>

<style>
  .field-index {
    margin-block: 1.5rem 2rem;
    padding-block: 1rem;
    border-block: 1px solid var(--sl-color-hairline);
  }

  .field-index-label {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .field-index-label code {
    font-size: inherit;
  }

  /* The Route index's filter, field for field, so the two lookups read as one tool. */
  .field-filter {
    margin-top: 0.75rem;
    max-inline-size: 24rem;
  }
  .field-filter label {
    display: block;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 0.25rem;
  }
  .field-filter input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.4rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-3) 75%, var(--sl-color-black));
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
  }
  .field-filter input::placeholder {
    color: var(--sl-color-gray-3);
  }
  .field-filter-status {
    margin: 0.25rem 0 0;
    min-height: 1.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  /*
   * A band is a label and its fields on one wrapping line, like the Route
   * index's jump list: seven short rows rather than a 55-line column, so the index
   * stays one screen on a phone. The band name is a link to the band's page,
   * in the body face; the fields are in the code face because they are keys.
   */
  .field-group {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0 1rem;
    align-items: baseline;
    padding-block: 0.4rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  /* `display: grid` outranks the UA's `[hidden]`, so a filtered-out band stayed. */
  .field-group[hidden] {
    display: none;
  }
  .field-group:first-of-type {
    margin-top: 0.75rem;
  }

  .field-band {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    padding-block: 0.1875rem;
  }
  .field-band:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .field-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  .field-group li {
    margin: 0;
  }
  .field-group li a {
    display: inline-block;
    padding-block: 0.1875rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .field-group li a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 50rem) {
    .field-group {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  // Progressive: without script the filter stays hidden and the index is whole.
  const box = document.querySelector<HTMLElement>('[data-field-filter]');
  const input = box?.querySelector<HTMLInputElement>('input');
  const status = box?.querySelector<HTMLElement>('.field-filter-status');
  const fields = [...document.querySelectorAll<HTMLElement>('[data-field]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-field-group]')];
  if (box && input && status) {
    box.hidden = false;
    input.addEventListener('input', () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const field of fields) {
        const match = terms.every((t) => (field.dataset.field ?? '').includes(t));
        field.hidden = !match;
        if (match) shown++;
      }
      for (const group of groups) {
        group.hidden = !group.querySelector('[data-field]:not([hidden])');
      }
      status.textContent = terms.length
        ? shown === 0
          ? 'No field matches.'
          : `${shown} of ${fields.length} fields · Enter opens the first`
        : '';
    });
    // The lookup ends at the field: Enter goes to the first match.
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || !input.value.trim()) return;
      const first = document.querySelector<HTMLAnchorElement>('[data-field]:not([hidden]) a');
      if (!first) return;
      event.preventDefault();
      location.href = first.href;
    });
  }
</script>
