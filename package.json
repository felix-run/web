{
  "name": "felix-web",
  "version": "0.1.0",
  "private": true,
  "description": "Felix web monorepo \u2014 chat-ui, float, and docs on Cloudflare Workers for the Python harness. Turborepo + Biome + shared @felix/ui.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "check-api-drift": "node scripts/check-api-drift.mjs apps/chat-ui/harness-openapi.json apps/chat-ui/src/api.ts apps/float/src/api.ts",
    "check-protocol-parity": "node scripts/check-protocol-parity.mjs packages/felix-protocol/src/types.ts apps/chat-ui/src/App.tsx apps/float/src/App.tsx",
    "sync:theme": "pnpm --filter @felix/design sync:theme",
    "docs:dev": "pnpm --filter @felix/docs dev",
    "docs:build": "pnpm --filter @felix/docs build",
    "docs:deploy": "pnpm --filter @felix/docs run deploy",
    "chat:dev": "pnpm --filter @felix/chat-ui dev",
    "chat:build": "pnpm --filter @felix/chat-ui build",
    "chat:deploy": "pnpm --filter @felix/chat-ui run deploy",
    "float:dev": "pnpm --filter @felix/float dev",
    "float:build": "pnpm --filter @felix/float build",
    "float:deploy": "pnpm --filter @felix/float run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^25.7.0",
    "turbo": "^2.5.8",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2"
}
