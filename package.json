{
  "name": "felix-web",
  "version": "0.1.0",
  "private": true,
  "description": "Felix web monorepo \u2014 web and docs on Cloudflare Workers for the Python harness. Turborepo + Biome + shared @felix/ui.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "check-api-drift": "node scripts/check-api-drift.mjs apps/web/harness-openapi.json apps/web/src/api/client.ts packages/felix-client/src/transport.ts packages/felix-client/src/management/*.ts",
    "check-api-drift:live": "node scripts/check-api-drift.mjs --live apps/web/harness-openapi.json apps/web/src/api/client.ts packages/felix-client/src/transport.ts packages/felix-client/src/management/*.ts",
    "check-protocol-parity": "node scripts/check-protocol-parity.mjs packages/felix-protocol/src/types.ts packages/felix-client/src/engine.ts",
    "check-tailwind-sources": "node scripts/check-tailwind-sources.mjs",
    "check-state-palette": "node scripts/check-state-palette.mjs",
    "check-payload-shapes": "node scripts/check-payload-shapes.mjs",
    "check-bundle-budget": "node scripts/check-bundle-budget.mjs",
    "sync:harness": "node scripts/sync-harness-contract.mjs",
    "sync:diagrams": "node scripts/sync-harness-diagrams.mjs",
    "sync:brand": "pnpm --filter @felix/design sync:brand",
    "sync:theme": "pnpm --filter @felix/design sync:theme",
    "tui:dev": "pnpm --filter @felix/tui dev",
    "tui:build": "pnpm --filter @felix/tui build",
    "docs:dev": "pnpm --filter @felix/docs dev",
    "docs:build": "pnpm --filter @felix/docs build",
    "docs:deploy": "pnpm --filter @felix/docs run deploy",
    "web:dev": "pnpm --filter @felix/web dev",
    "web:build": "pnpm --filter @felix/web build",
    "web:deploy": "pnpm --filter @felix/web run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^25.7.0",
    "@types/react": "catalog:",
    "turbo": "^2.5.8",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2"
}
