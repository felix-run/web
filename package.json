{
  "name": "felix-web",
  "version": "0.1.0",
  "private": true,
  "description": "Felix web monorepo — chat-ui + docs on Cloudflare Workers for the Python harness. Turborepo + Biome + shared @felix/ui.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "docs:dev": "pnpm --filter @felix/docs dev",
    "docs:build": "pnpm --filter @felix/docs build",
    "docs:deploy": "pnpm --filter @felix/docs run deploy",
    "chat:dev": "pnpm --filter @felix/chat-ui dev",
    "chat:build": "pnpm --filter @felix/chat-ui build",
    "chat:deploy": "pnpm --filter @felix/chat-ui run deploy",
    "float:dev": "pnpm --filter @felix/float dev",
    "float:build": "pnpm --filter @felix/float build",
    "float:deploy": "pnpm --filter @felix/float run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@types/node": "^25.7.0",
    "turbo": "^2.5.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2"
}
